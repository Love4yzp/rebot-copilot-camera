# runtime data — operator's teach/playback libraries live here, never committed
# (root-anchored: an unanchored name also swallows a same-named package dir)
# v2 libraries
/poses/
/sequences/
/templates/
# drop-in plugins — the user's own code, synced by device.sh push, never committed
/plugins/

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# node / frontend
node_modules/
frontend/dist/
backend/static/

# platformio (firmware/esp32-shutter)
.pio/
.vscode/

# os
.DS_Store

# typescript incremental build cache
*.tsbuildinfo

# AI
.kimi/
.agent_context/