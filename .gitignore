# runtime data — operator's teach/playback libraries, one JSON per document,
# never committed; everything under one app/data/ root (REBOT_DATA_DIR overrides)
/app/data/
# drop-in plugins — the user's own code, synced by device.sh push, never committed
/app/plugins/

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# node / frontend
node_modules/
app/frontend/dist/
app/backend/static/

# platformio (firmware/esp32-shutter)
.pio/
.vscode/

# os
.DS_Store

# typescript incremental build cache
*.tsbuildinfo

# AI
.kimi/
.agent_context/
.zcode/
.scratch/