@@ -0,0 +1,27 @@
+"""MeshCat's internal server, with HTTP and ZMQ explicitly loopback-only.
+
+meshcat 0.3.2's host parameter controls its URL and ZMQ, not HTTP listen.
+Constrain Tornado in this isolated subprocess; never patch the host process.
+"""
+
+import json
+import sys
+import tornado.web
+from meshcat.servers.zmqserver import ZMQWebSocketBridge
+
+
+def main():
+    original = tornado.web.Application.listen
+
+    def loopback_listen(self, port, address=None, **kwargs):
+        return original(self, port, address="127.0.0.1", **kwargs)
+
+    tornado.web.Application.listen = loopback_listen
+    bridge = ZMQWebSocketBridge(host="127.0.0.1")
+    print(json.dumps({"zmq": bridge.zmq_url, "web": bridge.web_url}), flush=True)
+    sys.stdout = sys.stderr
+    bridge.run()
+
+
+if __name__ == "__main__":
+    main()
