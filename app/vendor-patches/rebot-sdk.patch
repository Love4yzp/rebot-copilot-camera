+"""Read-only MeshCat projection of robot feedback, isolated from control ticks."""
+
+import logging
+import json
+import subprocess
+import sys
+from pathlib import Path
+import threading
+from urllib.parse import urlsplit
+
+import meshcat
+import numpy as np
+import pinocchio as pin
+from pinocchio.visualize import MeshcatVisualizer
+import zmq
+
+log = logging.getLogger(__name__)
+
+
+def viewer_assets() -> Path:
+    return Path(meshcat.__file__).parent / "viewer" / "dist"
+
+
+class ViewerSession:
+    """Latest-value mailbox. All ZMQ calls belong to the visualization worker."""
+
+    def __init__(self, *, urdf_path: str, joint_names):
+        self.urdf_path = urdf_path
+        self.joint_names = tuple(joint_names)
+        self._lock = threading.Lock()
+        self._latest = None
+        self._stop = threading.Event()
+        self._ready = threading.Event()
+        self._thread = None
+        self._process = None
+        self.url = None
+        self.error = None
+
+    def start(self):
+        self._thread = threading.Thread(target=self._run, name="meshcat-feedback", daemon=True)
+        self._thread.start()
+        if not self._ready.wait(20) or self.error:
+            self.close()
+            raise RuntimeError(self.error or "MeshCat startup timed out")
+
+    def publish(self, joints):
+        with self._lock:
+            self._latest = dict(joints)
+
+    def _run(self):
+        visualizer = None
+        try:
+            model = pin.buildModelFromUrdf(self.urdf_path)
+            geometry = pin.buildGeomFromUrdf(
+                model,
+                self.urdf_path,
+                pin.GeometryType.VISUAL,
+                package_dirs=str(Path(self.urdf_path).parent.parent),
+            )
+            self._process = subprocess.Popen(
+                [sys.executable, "-u", "-m", "reBotArm_control_py.viewer_server"],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.DEVNULL,
+                text=True,
+                start_new_session=True,
+            )
+            addresses = json.loads(self._process.stdout.readline())
+            visualizer = meshcat.Visualizer(zmq_url=addresses["zmq"])
+            socket = visualizer.window.zmq_socket
+            socket.setsockopt(zmq.RCVTIMEO, 1000)
+            socket.setsockopt(zmq.SNDTIMEO, 1000)
+            socket.setsockopt(zmq.LINGER, 0)
+            viewer = MeshcatVisualizer(model, collision_model=None, visual_model=geometry)
+            viewer.initViewer(visualizer, loadModel=False)
+            viewer.loadViewerModel(color=np.array([0.65, 0.65, 0.68, 1.0]))
+            visualizer["/Axes"].set_property("visible", False)
+            visualizer["/Background"].set_property("top_color", [0.039, 0.039, 0.043])
+            visualizer["/Background"].set_property("bottom_color", [0.039, 0.039, 0.043])
+            url = urlsplit(visualizer.url())
+            if url.hostname not in {"127.0.0.1", "localhost"}:
+                raise RuntimeError("MeshCat must bind to loopback")
+            self.url = f"ws://127.0.0.1:{url.port}/"
+            self._ready.set()
+            while not self._stop.is_set():
+                with self._lock:
+                    joints, self._latest = self._latest, None
+                if joints is not None:
+                    q = pin.neutral(model)
+                    for name in self.joint_names:
+                        if name in joints and model.existJointName(name):
+                            q[model.joints[model.getJointId(name)].idx_q] = joints[name]
+                    viewer.display(q)
+                self._stop.wait(0.05)
+        except Exception as exc:
+            self.error = str(exc)
+            log.exception("visualization unavailable")
+            self._ready.set()
+        finally:
+            if visualizer is not None:
+                visualizer.window.zmq_socket.close(linger=0)
+            if self._process is not None and self._process.poll() is None:
+                self._process.terminate()
+                try:
+                    self._process.wait(timeout=2)
+                except Exception:
+                    self._process.kill()
+
+    def close(self):
+        self._stop.set()
+        if self._process is not None and self._process.poll() is None:
+            self._process.terminate()
+        if self._thread is not None:
+            self._thread.join(timeout=3)
